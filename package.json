{
  "name": "django-navigator",
  "displayName": "Django Navigator",
  "description": "Navigate Django URLs from templates.",
  "version": "1.1.2",
  "publisher": "KayoRiccelo",
  "icon": "imagens/django_navigator_                                                                            logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kayoriccelo/django-navigator-vscode.git"
  },
  "engines": {
    "vscode": "^1.50.0"
  },
  "activationEvents": [
    "onCommand:django-navigator.goToUrl",
    "onLanguage:html"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
        {
            "id": "html",
            "extensions": [".html"],
            "configuration": "./language-configuration.json"
        },
        {
          "id": "django-html",
          "aliases": ["Django HTML"],
          "extensions": [".html"],
          "configuration": "./language-configuration.json"
        }
    ],
    "commands": [
      {
        "command": "django-navigator.goToUrl",
        "title": "Django Navigator: Go to url"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepublish": "npm run compile"
  },
  "devDependencies": {
    "typescript": "^4.0.0",
    "vscode": "^1.1.36"
  }
}

